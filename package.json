{
  "name": "artifactum",
  "private": true,
  "version": "2.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "get-android-version": "node scripts/get-android-version.js",
    "sync-android-version": "node scripts/sync-android-version.js",
    "update-android": "npm run build && npm run sync-android-version && npx cap sync android",
    "build-debug-apk": "cd android && gradlew assembleDebug",
    "upload-release": "node scripts/upload-release.js",
    "release": "npm run update-android && npm run build-debug-apk && node scripts/upload-release.js",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^8.0.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.47.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.563.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "sass": "^1.83.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
